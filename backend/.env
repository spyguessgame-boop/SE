# --- Gemini (Google AI Studio) ---
# Replace with your newly regenerated API key
GEMINI_API_KEY=

# Use a valid, stable model name
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Zoom RTMS (only needed for REAL live meetings, not for demo mode) ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# --- Server ---
PORT=8080
# Set to true to skip Zoom entirely and replay the sample transcript instead
DEMO_MODE=false