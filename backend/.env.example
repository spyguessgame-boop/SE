# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=AQ.Ab8RN6LDgy2Ss3SoHRyn-Jt2x3K7WzAA8wdZ85dDEq73h9hLbA
# Check https://ai.google.dev/gemini-api/docs/models for the current valid model name
# before your demo -- model names change over time.
GEMINI_MODEL=gemini-2.0-flash

# --- Zoom RTMS (only needed for REAL live meetings, not for demo mode) ---
ZOOM_CLIENT_ID=your_zoom_general_app_client_id
ZOOM_CLIENT_SECRET=your_zoom_general_app_client_secret
ZOOM_SECRET_TOKEN=your_zoom_webhook_secret_token

# --- Server ---
PORT=8080
# Set to true to skip Zoom entirely and replay the sample transcript instead
DEMO_MODE=true
