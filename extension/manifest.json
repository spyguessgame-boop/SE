{
  "manifest_version": 3,
  "name": "AI Requirement Analyzer",
  "version": "1.0.0",
  "description": "Real-time ambiguity detection and requirement elicitation for Google Meet.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_title": "Open Requirement Analyzer",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}